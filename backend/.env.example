# ── AirGuard Backend – Variables de Entorno v0.7.0 ───────────────
# Copia como .env y completa los valores reales

# ── Base de datos ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@HOST/?retryWrites=true&w=majority

# ── Servidor ──────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=

# ── OpenAQ ────────────────────────────────────────────────────────
OPENAQ_API_KEY=TU_OPENAQ_API_KEY
OPENAQ_FETCH_INTERVAL_MS=90000
OPENAQ_DAILY_LIMIT=1000

# ── Panel Admin ───────────────────────────────────────────────────
ADMIN_PASSWORD=pon-aqui-una-clave-segura
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=genera-un-secreto-largo-aqui

# ── Alertas por Email (SMTP) ──────────────────────────────────────
# Para Gmail: activa "App Passwords" en tu cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail
ALERT_EMAIL_FROM=AirGuard SV <tu-email@gmail.com>

# Umbral AQI para disparar alertas automáticas (default: 100)
ALERT_AQI_THRESHOLD=100

# ── Web Push Notifications ────────────────────────────────────────
# Genera las claves VAPID con: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
