# ── AirGuard Backend – Variables de Entorno v0.9.5 
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a GitHub.

# ── Base de datos 
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@HOST/airguard?retryWrites=true&w=majority&appName=airguard

# ── Servidor ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=
# En Render se configura automáticamente via render.yaml:
# FRONTEND_DIR=/opt/render/project/src/public

# ── OpenAQ API v3 ─────────────────────────────────────────────────
OPENAQ_API_KEY=TU_OPENAQ_API_KEY
OPENAQ_FETCH_INTERVAL_MS=90000
OPENAQ_DAILY_LIMIT=1000

# ── Modo de datos ─────────────────────────────────────────────────
# true  → siempre usar datos simulados (útil si OpenAQ no cubre El Salvador)
# false → intentar OpenAQ real; caer a simulado automáticamente si no hay datos
SIMULATE_DATA=false

# ── Panel Admin ───────────────────────────────────────────────────
ADMIN_PASSWORD=pon-aqui-una-clave-segura
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=genera-un-secreto-largo-aqui

# ── Alertas por Email (SMTP) ──────────────────────────────────────
# Para Gmail: activa verificación en 2 pasos y crea una "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail-16-caracteres
ALERT_EMAIL_FROM=AirGuard SV <tu-email@gmail.com>

# Umbral AQI para disparar alertas automáticas (0-500, default: 100)
# Tip para pruebas: ponlo en 1 para forzar el envío en el próximo ciclo
ALERT_AQI_THRESHOLD=100

# ── Web Push Notifications (VAPID) ───────────────────────────────
# Genera las claves con:
# node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# IMPORTANTE: genera una sola vez y guarda. Si cambias las claves, las
# suscripciones push existentes quedan inválidas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
